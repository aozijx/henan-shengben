{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://henan-shengben.local/metadata.schema.json",
  "title": "school-data metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "defaultYear",
    "supportedYears",
    "yearSources",
    "sourceFields",
    "derivedFields",
    "fields",
    "yearFieldTemplates",
    "defaultSort",
    "pageSize",
    "exportFormat"
  ],
  "properties": {
    "schemaVersion": { "enum": [2, 3] },
    "catalogSource": { "type": "string", "minLength": 1 },
    "conversionReports": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["year", "sourceManifest", "inputMajorCount", "publishedMajorCount", "officialEmptyCount", "sourceUnavailableCount", "blockingCount"],
        "properties": {
          "year": { "type": "integer", "minimum": 2000 },
          "sourceManifest": { "type": "string", "minLength": 1 },
          "inputMajorCount": { "type": "integer", "minimum": 0 },
          "publishedMajorCount": { "type": "integer", "minimum": 0 },
          "officialEmptyCount": { "type": "integer", "minimum": 0 },
          "sourceUnavailableCount": { "type": "integer", "minimum": 0 },
          "blockingCount": { "const": 0 },
          "officialEmpty": { "type": "array", "items": { "type": "object" } },
          "sourceUnavailable": { "type": "array", "items": { "type": "object" } }
        }
      }
    },
    "queryMappingYear": { "type": "integer", "minimum": 2000 },
    "queryMappingSource": { "type": "string", "minLength": 1 },
    "sourceCatalog": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mapping": { "$ref": "#/definitions/yearPaths" },
        "colleges": { "$ref": "#/definitions/yearPaths" },
        "plans": { "$ref": "#/definitions/yearPaths" },
        "scorelines": { "$ref": "#/definitions/yearPaths" },
        "scoreSegments": { "$ref": "#/definitions/yearPaths" }
      }
    },
    "defaultYear": { "type": "integer", "minimum": 2000 },
    "supportedYears": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "integer", "minimum": 2000 },
      "uniqueItems": true
    },
    "uiDefaults": {
      "type": "object",
      "additionalProperties": false,
  "properties": {
        "selectedYears": { "const": "allSupportedYears" },
        "resultLayout": { "enum": ["cards", "table"] }
      }
    },
    "resultVisibilityRules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["when", "hide"],
        "properties": {
          "when": {
            "type": "object",
            "additionalProperties": false,
            "required": ["filterKey", "equals"],
            "properties": {
              "filterKey": { "type": "string", "minLength": 1 },
              "equals": { "type": "string", "minLength": 1 }
            }
          },
          "hide": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          }
        }
      }
    },
    "yearSources": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["mappingSource", "scoreSource", "planSource", "scoreSegmentSource"],
        "properties": {
          "mappingSource": { "type": "string", "minLength": 1 },
          "queryIndexSource": { "type": "string", "minLength": 1 },
          "mappingReferenceYear": { "type": "integer", "minimum": 2000 },
          "scoreSource": { "type": "string", "minLength": 1 },
          "planSource": { "type": "string", "minLength": 1 },
          "scoreSegmentSource": { "type": "string", "minLength": 1 },
          "analyticsSource": { "type": "string", "minLength": 1 },
          "scoreSegmentIndexSource": { "type": "string", "minLength": 1 },
          "scoreSegmentShardTemplate": { "type": "string", "minLength": 1 },
          "collegeFallbackSource": { "type": "string", "minLength": 1 }
        }
      }
    },
    "sourceFields": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "majorCode", "majorName", "disciplineCode6",
        "professionalCourseCode", "professionalCourseName"
      ],
      "properties": {
        "majorCode": { "type": "string", "minLength": 1 },
        "majorName": { "type": "string", "minLength": 1 },
        "disciplineCode6": { "type": "string", "minLength": 1 },
        "professionalCourseCode": { "type": "string", "minLength": 1 },
        "professionalCourseName": { "type": "string", "minLength": 1 }
      }
    },
    "derivedFields": {
      "type": "object",
      "additionalProperties": false,
      "required": ["publicCourse"],
      "properties": {
        "publicCourse": {
          "type": "object",
          "additionalProperties": false,
          "required": ["defaultLabel", "professionalEnglishPattern", "professionalEnglishLabel"],
          "properties": {
            "defaultLabel": { "type": "string", "minLength": 1 },
            "professionalEnglishPattern": { "type": "string", "minLength": 1 },
            "professionalEnglishLabel": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "fields": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key", "label", "exportLabel", "type",
          "filterEnable", "sortEnable", "tableShow", "exportEnable"
        ],
        "properties": {
          "key": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "exportLabel": { "type": "string", "minLength": 1 },
          "type": { "enum": ["string", "number", "enum", "boolean"] },
          "enumValues": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "min": { "type": "number" },
          "max": { "type": "number" },
          "sortKey": { "type": "string", "minLength": 1 },
          "filterDefault": { "type": "string", "minLength": 1 },
          "sourceRole": { "const": "colleges" },
          "sourceColumn": { "type": "string", "minLength": 1 },
          "filterEnable": { "type": "boolean" },
          "sortEnable": { "type": "boolean" },
          "tableShow": { "type": "boolean" },
          "exportEnable": { "type": "boolean" }
        },
        "allOf": [
          {
            "if": { "properties": { "type": { "const": "enum" } }, "required": ["type"] },
            "then": { "required": ["enumValues"] }
          }
        ]
      }
    },
    "yearFieldTemplates": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/properties/fields/items" }
    },
    "defaultSort": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "direction"],
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "direction": { "enum": ["asc", "desc", "original"] }
      }
    },
    "pageSize": { "type": "integer", "minimum": 1 },
    "exportFormat": { "const": "csv" }
  },
  "definitions": {
    "yearPaths": {
      "type": "object",
      "patternProperties": { "^[0-9]{4}$": { "type": "string", "minLength": 1 } },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": { "properties": { "schemaVersion": { "minimum": 3 } }, "required": ["schemaVersion"] },
      "then": {
        "properties": {
          "yearSources": {
            "additionalProperties": {
              "required": ["analyticsSource", "scoreSegmentIndexSource", "scoreSegmentShardTemplate"],
              "properties": {
                "scoreSegmentShardTemplate": { "pattern": "\\{majorCode\\}" }
              }
            }
          }
        }
      }
    }
  ]
}
