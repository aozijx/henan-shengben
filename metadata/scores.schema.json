{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://henan-shengben.local/scores.schema.json",
  "title": "分数线数据",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["专业代号", "专业名称", "分数线"],
    "properties": {
      "专业代号": { "type": "string", "minLength": 1 },
      "专业名称": { "type": "string", "minLength": 1 },
      "分数线": { "type": "number", "minimum": 0, "maximum": 750 }
    }
  }
}
