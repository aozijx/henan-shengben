{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "source-manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "dataset", "year", "sourcePageUrl", "discoveryUrl", "entries"],
  "properties": {
    "schemaVersion": {"const": 1},
    "dataset": {"const": "score-segments"},
    "year": {"type": "integer"},
    "sourcePageUrl": {"type": "string", "pattern": "^https?://"},
    "discoveryUrl": {"type": "string", "pattern": "^https?://"},
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["year", "sourcePageUrl", "pdfUrl", "localPath", "majorCode", "majorName", "downloadStatus", "sha256", "bytes"],
        "properties": {
          "year": {"type": "integer"},
          "sourcePageUrl": {"type": "string", "pattern": "^https?://"},
          "pdfUrl": {"type": "string", "pattern": "^https?://"},
          "localPath": {"type": "string", "minLength": 1},
          "majorCode": {"type": "string", "minLength": 1},
          "majorName": {"type": "string", "minLength": 1},
          "downloadStatus": {"enum": ["downloaded", "skipped"]},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "bytes": {"type": "integer", "minimum": 1}
        }
      }
    }
  }
}
