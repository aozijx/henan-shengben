{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "score-segments.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "year", "sourceManifest", "majors"],
  "properties": {
    "schemaVersion": {"const": 1},
    "year": {"type": "integer", "minimum": 2020},
    "sourceManifest": {"type": "string", "minLength": 1},
    "majors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["majorCode", "majorName", "controlScore", "sourceId", "sourcePdf", "sourceSha256", "segments"],
        "properties": {
          "majorCode": {"type": "string", "minLength": 1},
          "majorName": {"type": "string", "minLength": 1},
          "controlScore": {"type": ["integer", "null"], "minimum": 0},
          "sourceId": {"type": "string", "minLength": 1},
          "sourcePdf": {"type": "string", "minLength": 1},
          "sourceSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "segments": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["score", "cumulativeCount"],
              "properties": {
                "score": {"type": "integer", "minimum": 0},
                "cumulativeCount": {"type": "integer", "minimum": 0}
              }
            }
          }
        }
      }
    }
  }
}
