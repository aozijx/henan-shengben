{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "score-segments.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "year", "dataset", "sourceManifest", "majors"],
  "properties": {
    "schemaVersion": {"const": 2},
    "year": {"type": "integer", "minimum": 2020},
    "dataset": {"const": "score-segments"},
    "sourceManifest": {"type": "string", "minLength": 1},
    "summary": {"type": "object"},
    "majors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["majorCode", "majorName", "status", "path", "sha256"],
        "properties": {
          "majorCode": {"type": "string", "pattern": "^[A-Za-z0-9]+$"},
          "majorName": {"type": "string", "minLength": 1},
          "status": {"enum": ["ok", "needs-review", "official-empty"]},
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  }
}
