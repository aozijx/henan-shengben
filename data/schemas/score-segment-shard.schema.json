{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "score-segment-shard.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["majorCode", "majorName", "controlScore", "sourceId", "sourcePdf", "sourceSha256", "status", "issues", "segments"],
  "properties": {
    "majorCode": {"type": "string", "pattern": "^[A-Za-z0-9]+$"},
    "majorName": {"type": "string", "minLength": 1},
    "controlScore": {"type": ["integer", "null"], "minimum": 0},
    "sourceId": {"type": "string", "minLength": 1},
    "sourcePdf": {"type": "string", "minLength": 1},
    "sourceSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "status": {"enum": ["ok", "needs-review", "official-empty"]},
    "issues": {"type": "array", "items": {"type": "object"}},
    "segments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["score", "cumulativeCount"],
        "properties": {
          "score": {"type": "integer", "minimum": 0},
          "cumulativeCount": {"type": "integer", "minimum": 0}
        }
      }
    }
  }
}
